{
  "manifest_version": 3,
  "name": "Pause – Think Before You Send",
  "version": "1.0.0",
  "description": "Check your writing for emotional tone and cognitive biases before sending.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://pauseapp.space/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_title": "Pause"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://*.slack.com/*",
        "https://web.whatsapp.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}